# Copy to .env and fill in. Never commit .env.

# --- Read by Bifrost (docker-compose passes this file into the container) ---
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any random string. Bifrost OSS requires it as the X-Bifrost-Setup-Token header on every /api/* call
# (incl. cache eviction) while no dashboard admin exists. Generate: python -c "import secrets;print(secrets.token_hex(16))"
BIFROST_SETUP_TOKEN=

# --- Read by StaleGuard ---
TAVILY_API_KEY=
BIFROST_URL=http://localhost:8080
# Host port docker-compose publishes Bifrost on. Change both this and BIFROST_URL if 8080 is taken.
BIFROST_HOST_PORT=8080

# Models are addressed as <bifrost-provider>/<model>.
SMALL_MODEL=gemini/gemini-3.6-flash
# NOTE: gemini-3.1-pro-preview is NOT on the Gemini free tier (paid billing required).
# On a free-tier key, set this to gemini/gemini-3.6-flash.
JUDGE_MODEL=gemini/gemini-3.1-pro-preview
